---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Reveal from "@/components/Reveal.astro";
import ArticleBlock from "@/components/ArticleBlock.astro";
import { articles, type Article } from "@/data/articles";

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
---

<BaseLayout title={`${article.title} — Isaiah Adeleke`} description={article.description}>
  <article class="pb-24 pt-36 md:pb-32 md:pt-48">
    <div class="mx-auto max-w-content px-7 md:px-14 lg:px-20">
      <Reveal>
        <a href="/content" class="text-xs font-bold uppercase tracking-[.14em] text-[#7C56F6] hover:text-[#4930A8]">← Back to writing</a>
        <p class="mt-10 text-xs font-bold uppercase tracking-[.14em] text-muted">{article.category}</p>
        <h1 class="display-heading mt-5 max-w-5xl text-[clamp(2.7rem,5.2vw,5.5rem)] text-[#2D2350]">{article.title}</h1>
        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-ink/65 md:text-xl">{article.description}</p>
        <p class="mt-6 text-xs text-muted">By Isaiah Adeleke · {article.date}</p>
        {article.source && <a href={article.source.href} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-xs font-semibold text-[#7C56F6]">{article.source.label} ↗</a>}
      </Reveal>
      {article.cover && <Reveal delay={0.1}><div class="mt-12 overflow-hidden rounded-[2rem] border border-white bg-white shadow-[0_25px_65px_rgba(36,39,37,.1)]"><img src={article.cover.src} alt={article.cover.alt} class="h-auto w-full" /></div></Reveal>}
      {article.hero && <div class="mt-12"><ArticleBlock block={article.hero} /></div>}
      <div class="mx-auto mt-16 max-w-4xl space-y-10 md:mt-20">
        {article.sections.map((section) => <Reveal><section class="page-card p-7 md:p-12">{section.heading && <h2 class="display-heading mb-7 text-3xl leading-[1.08] text-[#2D2350] md:text-4xl">{section.heading}</h2>}<div class="space-y-6">{section.blocks.map((block) => <ArticleBlock block={block} />)}</div></section></Reveal>)}
        <a href="/content" class="inline-flex rounded-xl bg-[#241D35] px-6 py-4 text-sm font-bold text-white hover:bg-[#4930A8]">← Back to writing</a>
      </div>
    </div>
  </article>
</BaseLayout>
