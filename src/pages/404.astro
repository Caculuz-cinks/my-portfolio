---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found — Isaiah Adeleke">
  <section class="pt-36 md:pt-48 pb-24 md:pb-32">
    <div class="max-w-content mx-auto px-7 md:px-14 lg:px-20">
      <h1 class="display-heading gradient-ink text-[clamp(3rem,6vw,5.5rem)]">This page wandered off.</h1>
      <p class="mt-7 text-lg md:text-xl text-muted max-w-2xl">The link may be old, or the page has moved.</p>
      <a href="/" class="mt-10 inline-flex rounded-xl bg-[#241D35] px-6 py-4 text-sm font-bold text-white hover:bg-[#4930A8]">← Back home</a>
    </div>
  </section>
</BaseLayout>
