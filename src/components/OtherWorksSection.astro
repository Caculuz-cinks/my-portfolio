---
import Reveal from "./Reveal.astro";
import { contentItems } from "@/data/content";
---

<section class="py-20 md:py-28">
  <div class="max-w-content mx-auto px-7 md:px-14 lg:px-20">
    <Reveal>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 md:mb-16">
        <div>
          <h2 class="display-heading text-4xl md:text-6xl text-[#2D2350]">I share my thoughts.</h2>
          <p class="mt-5 max-w-2xl text-ink/65">Ideas from the intersection of AI, product design, teaching, and building useful things.</p>
        </div>
        <a href="/content" class="rounded-xl bg-[#7C56F6] text-white px-5 py-3 text-xs font-bold w-fit">Explore everything →</a>
      </div>
    </Reveal>

    <div class="page-card overflow-hidden divide-y divide-ink/10">
      {contentItems.slice(0, 3).map((item, index) => (
        <div class="reveal reveal-slide" style={`--reveal-x:-28px;--reveal-y:0px;--reveal-duration:.55s;--reveal-delay:${index * 0.07}s`}>
          <article class="group p-6 md:p-9 grid grid-cols-1 md:grid-cols-[180px_1fr_auto] gap-4 md:gap-8 items-center transition duration-300 hover:translate-x-2 hover:bg-[#7C56F6]/[0.04]">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-[#7C56F6]">{item.category}</p>
              <p class="mt-2 text-xs text-muted">{item.date}</p>
            </div>
            <div>
              <h3 class="font-sans text-xl md:text-2xl font-semibold tracking-[-0.04em] text-[#2D2350] group-hover:text-[#7C56F6] transition-colors">{item.title}</h3>
              <p class="mt-2 max-w-3xl text-sm text-ink/60">{item.description}</p>
            </div>
            <a href={item.href ?? "/content"} class="text-xs font-semibold text-[#7C56F6] hover:text-[#4930A8]">
              {item.type === "writing" ? "Read article" : "Explore"} ↗
            </a>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
