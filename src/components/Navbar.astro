---
const links = [
  { href: "/projects", label: "Projects" },
  { href: "/shots", label: "UI Shots" },
  { href: "/about", label: "About" },
  { href: "/content", label: "Content" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? pathname === "/" : pathname.startsWith(href));
---

<header class="fixed inset-x-0 top-0 z-50 pointer-events-none">
  <div class="max-w-content mx-auto px-7 md:px-14 lg:px-20 pt-5 md:pt-7 grid grid-cols-2 md:grid-cols-3 items-center">
    <a href="/" class="pointer-events-auto flex items-center gap-2.5 w-fit group rounded-full border border-[#241D35]/10 bg-white/90 p-1.5 pr-4 shadow-[0_8px_24px_rgba(36,29,53,.09)] backdrop-blur-xl">
      <span class="w-8 h-8 rounded-full overflow-hidden border border-white shadow-sm bg-creamdark">
        <img src="/photos/isaiah-headshot.png" alt="Isaiah Adeleke" width="32" height="32" class="w-full h-full object-cover" />
      </span>
      <span class="hidden sm:block font-sans text-sm font-bold tracking-[-0.03em] text-[#241D35]">Isaiah Adeleke</span>
    </a>

    <nav class="pointer-events-auto hidden md:flex justify-self-center items-center rounded-full bg-white/90 backdrop-blur-xl p-1.5 border border-white shadow-[0_12px_36px_rgba(36,39,37,0.12)]">
      {links.map((link) => (
        <a
          href={link.href}
          data-cursor-hover
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={["relative whitespace-nowrap rounded-full px-5 py-2 text-xs font-semibold transition-colors", isActive(link.href) ? "text-white" : "text-ink/65 hover:text-ink"]}
        >
          {isActive(link.href) && <span class="absolute inset-0 rounded-full bg-[#7C56F6]" style="view-transition-name: active-nav" />}
          <span class="relative z-10">{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="justify-self-end flex items-center gap-2 pointer-events-auto">
      <a href="mailto:isaiahadeleke01@gmail.com" class="hidden md:inline-flex items-center gap-2 rounded-full border border-white/60 bg-[#4930A8] text-white text-xs font-semibold px-5 py-2.5 shadow-[0_8px_24px_rgba(73,48,168,.2)] hover:-translate-y-0.5 transition-transform">
        Let&apos;s talk
      </a>
      <button type="button" data-menu-open aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden w-11 h-11 rounded-full bg-white shadow-md flex items-center justify-center">
        <span class="text-xl">☰</span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" hidden class="mobile-menu fixed inset-0 z-[60] bg-[#F3EFE7] px-6 py-6 flex-col">
  <div class="flex justify-between items-center">
    <span class="font-bold">Isaiah Adeleke</span>
    <button type="button" data-menu-close aria-label="Close menu" class="w-11 h-11 rounded-full bg-white text-xl shadow-sm">×</button>
  </div>
  <nav class="flex-1 flex flex-col justify-center gap-3">
    {links.map((link, index) => (
      <div class="mobile-menu-link" style={`--menu-delay:${index * 0.07}s`}>
        <a href={link.href} class="display-heading text-[clamp(2.6rem,11vw,4.5rem)] text-[#4930A8]">{link.label}</a>
      </div>
    ))}
  </nav>
  <a href="mailto:isaiahadeleke01@gmail.com" class="rounded-2xl bg-[#4930A8] text-white py-4 text-center font-semibold">Let&apos;s talk</a>
</div>

<style>
  .mobile-menu:not([hidden]) {
    display: flex;
    animation: menu-fade 0.25s ease both;
  }

  .mobile-menu:not([hidden]) .mobile-menu-link {
    animation: menu-link 0.4s cubic-bezier(0.22, 1, 0.36, 1) var(--menu-delay) both;
  }

  @keyframes menu-fade {
    from { opacity: 0; }
  }

  @keyframes menu-link {
    from { opacity: 0; transform: translateX(-24px); }
  }
</style>

<script>
  const menu = document.getElementById("mobile-menu");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");

  const setOpen = (open: boolean) => {
    if (!menu) return;
    menu.hidden = !open;
    openButton?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
    if (!open) openButton?.focus();
  };

  openButton?.addEventListener("click", () => setOpen(true));
  menu?.querySelector("[data-menu-close]")?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) setOpen(false);
  });
</script>
