---
import Reveal from "./Reveal.astro";
import { contentItems } from "@/data/content";

const tabs = [
  { id: "writing", label: "Writing", empty: "More writing is on the way." },
  { id: "talk", label: "Talks & Classes", empty: "Talks and classes will appear here when available." },
] as const;
---

<div data-content-list>
  <Reveal>
    <div class="inline-flex bg-white/80 rounded-full p-1.5 border border-ink/10 shadow-sm">
      {tabs.map((tab, index) => (
        <button
          type="button"
          data-tab={tab.id}
          data-cursor-hover
          aria-pressed={index === 0 ? "true" : "false"}
          class="text-sm px-5 py-2 rounded-full transition-colors text-ink/70 aria-pressed:bg-[#7C56F6] aria-pressed:text-white"
        >
          {tab.label}
        </button>
      ))}
    </div>
  </Reveal>

  {tabs.map((tab, tabIndex) => {
    const filtered = contentItems.filter((c) => c.type === tab.id);
    return (
      <div data-panel={tab.id} hidden={tabIndex !== 0} class="mt-12 divide-y divide-ink/10">
        {filtered.length === 0 && <p class="py-12 text-muted">{tab.empty}</p>}
        {filtered.map((item, i) => (
          <div
            class="reveal reveal-slide py-8 flex flex-col md:flex-row md:items-start gap-6 group"
            style={`--reveal-y:16px;--reveal-duration:.5s;--reveal-delay:${i * 0.05}s`}
          >
            {item.type === "talk" && item.href ? (
              <a href={item.href} aria-label={`Watch ${item.title}`} class="relative block aspect-video w-full shrink-0 overflow-hidden rounded-xl border border-ink/10 bg-[#241D35] md:w-60">
                {item.image && <img src={item.image} alt={`${item.title} — video preview`} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />}
                <span class="absolute inset-0 bg-black/20 transition-colors group-hover:bg-black/10"></span>
                <span class="absolute left-3 top-3 rounded-md bg-[#E42B2B] px-2 py-1 text-[10px] font-bold text-white">YouTube</span>
                <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true"><span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/95 text-xl text-[#4930A8] shadow-lg transition-transform group-hover:scale-110"><span class="ml-1">▶</span></span></span>
              </a>
            ) : item.hasPhoto && (
              item.image && item.href ? (
                <a href={item.href} class="shrink-0 block w-full md:w-40 aspect-[4/3] overflow-hidden rounded-xl bg-[#F0EDE8] border border-ink/10" aria-label={`Read ${item.title}`}>
                  <img src={item.image} alt={`${item.title} — article cover`} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                </a>
              ) : (
                <div class="shrink-0 w-full md:w-40 aspect-[4/3] rounded-xl bg-[#F0EDE8] border border-ink/10 flex items-center justify-center text-xs text-muted text-center px-2">
                  Photo
                </div>
              )
            )}
            <div class="flex-1">
              <p class="text-xs uppercase tracking-wide text-muted mb-2">{item.category}</p>
              <h3 class="font-sans font-semibold tracking-[-0.04em] text-xl md:text-2xl text-[#2D2350] group-hover:text-[#7C56F6] transition-colors">
                {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              </h3>
              <p class="mt-2 text-muted max-w-xl">{item.description}</p>
              {item.metric && <p class="mt-3 w-fit rounded-full border border-[#7C56F6]/15 bg-[#7C56F6]/5 px-3 py-1 text-xs font-semibold text-[#4930A8]">{item.metric}</p>}
              {item.href && (
                <a href={item.href} class={item.type === "talk" ? "mt-4 inline-flex items-center gap-2 rounded-xl bg-[#4930A8] px-4 py-2.5 text-xs font-bold text-white transition-colors hover:bg-[#7C56F6]" : "mt-4 inline-flex text-xs font-bold text-[#7C56F6] hover:text-[#4930A8]"}>
                  {item.type === "writing" ? "Read article →" : <Fragment><span aria-hidden="true">▶</span> Watch Now</Fragment>}
                </a>
              )}
            </div>
            <div class="shrink-0 text-sm text-muted md:text-right">{item.date}</div>
          </div>
        ))}
      </div>
    );
  })}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-content-list]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    for (const button of buttons) {
      button.addEventListener("click", () => {
        for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
        for (const panel of panels) {
          panel.hidden = panel.dataset.panel !== button.dataset.tab;
          // Items in a newly shown tab were never in view, so show them straight away.
          if (!panel.hidden) panel.querySelectorAll(".reveal").forEach((item) => item.classList.add("is-visible"));
        }
      });
    }
  }
</script>
