---
const cards = [
  {
    title: "Recent work",
    text: "How I turn complex product problems into clear, shipped experiences.",
    href: "/projects",
    action: "View case studies",
    color: "#F5D7A1",
    rotate: -3.5,
  },
  {
    title: "About me",
    text: "Product designer, builder, teacher—and someone who believes good work should move the business.",
    href: "/about",
    action: "A bit about me",
    color: "#E5DFFC",
    rotate: 2.5,
  },
  {
    title: "I share my thoughts",
    text: "Notes, talks, and classes on AI, product design, and making technology useful.",
    href: "/content",
    action: "Read & watch",
    color: "#D7E8F6",
    rotate: -1.5,
  },
];

const hoverStyle = (index: number) =>
  `--hover-y:${index % 2 === 0 ? -40 : -32}px;--hover-x:${index === 1 ? 8 : -5}px;--hover-rotate:${index % 2 === 0 ? 3 : -3}deg;`;
---

<section data-hero class="relative pt-32 md:pt-40 pb-16 md:pb-24 overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-[760px] fine-grid opacity-100 pointer-events-none [mask-image:linear-gradient(to_bottom,black_68%,transparent)]"></div>
  <div class="max-w-content mx-auto px-7 md:px-14 lg:px-20 relative">
    <div data-parallax="90" class="max-w-[1220px] will-change-transform">
      <div
        class="hero-in inline-flex items-center gap-2 rounded-full border border-[#7C56F6]/15 bg-white/75 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.16em] text-[#7C56F6] shadow-sm"
        style="--hero-y:16px;--hero-duration:.55s"
      >
        <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-violet-400 opacity-60"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-[#7C56F6]"></span></span>
        Available for selected opportunities
      </div>

      <h1
        class="hero-in display-heading gradient-ink mt-8 text-[clamp(3rem,6.7vw,6.25rem)]"
        style="--hero-y:38px;--hero-duration:.8s;--hero-delay:.08s"
      >
        Hi, I&apos;m Isaiah.<br />Product designer <span class="text-[#A48AFB]">&amp;</span> builder.
      </h1>

      <p
        class="hero-in mt-8 max-w-3xl text-lg md:text-2xl leading-snug tracking-[-0.025em] text-ink/70"
        style="--hero-delay:.22s"
      >
        Senior Product Designer with{" "}
        <span class="group/ml relative inline-flex cursor-help border-b border-dashed border-[#7C56F6]/60 text-[#4930A8]">
          ML
          <span class="pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 w-max max-w-[260px] -translate-x-1/2 translate-y-1 rounded-xl bg-[#241D35] px-4 py-2.5 text-center text-xs font-medium tracking-normal text-white opacity-0 shadow-xl transition duration-150 group-hover/ml:translate-y-0 group-hover/ml:opacity-100">
            Machine Learning and Human Computer Interaction
          </span>
        </span>{" "}
        background working at the intersection of design, engineering, AI, and business.
      </p>

      <div
        class="hero-in mt-7 max-w-3xl text-base md:text-lg leading-relaxed font-semibold text-ink/80"
        style="--hero-delay:.29s"
      >
        Designing clinical AI products at{" "}
        <span class="group/helium relative inline-flex align-middle">
          <a href="https://heliumhealth.com" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full border border-[#7C56F6]/15 bg-white/90 py-1.5 pl-1.5 pr-3 text-sm font-bold text-[#4930A8] shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <span class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-full bg-[#F0ECFF] p-1.5">
              <img src="/logos/helium-health.svg" alt="" class="h-full w-full object-contain" />
            </span>
            Helium Health (YC ’17)
          </a>
          <span class="pointer-events-none absolute bottom-full left-1/2 z-50 mb-3 w-80 -translate-x-1/2 translate-y-2 rounded-[1.5rem] border border-ink/10 bg-white p-3 text-[#241D35] opacity-0 shadow-[0_22px_55px_rgba(36,29,53,.18)] transition duration-200 group-hover/helium:translate-y-0 group-hover/helium:opacity-100">
            <span class="flex h-32 items-center justify-center rounded-[1.1rem] bg-[#F0ECFF]">
              <span class="flex h-20 w-20 items-center justify-center rounded-2xl bg-white p-4 shadow-sm">
                <img src="/logos/helium-health.svg" alt="Helium Health logo" loading="lazy" class="h-full w-full object-contain" />
              </span>
            </span>
            <span class="mt-3 block px-1 text-base font-bold">Helium Health</span>
            <span class="mt-1 block px-1 text-xs font-normal leading-relaxed text-ink/60">Technology and financial infrastructure helping healthcare providers deliver better care across Africa.</span>
          </span>
        </span>{" "}
        {" "}by day. Building products and teaching people how to use AI by night.
      </div>
    </div>

    <div data-parallax="-55" class="mt-16 md:mt-24 grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-0 md:px-4 items-stretch will-change-transform">
      {[cards[0], null, cards[1], cards[2]].map((card, index) => card ? (
        <div class="hero-in relative md:-ml-6 flex" style={`--hero-y:50px;--hero-duration:.6s;--hero-delay:${0.2 + index * 0.07}s;z-index:${12 - index}`}>
          <article
            class="hero-card relative w-full min-h-[270px] md:min-h-[325px] rounded-[1.75rem] p-6 flex flex-col justify-between border border-white/80 shadow-[0_24px_52px_rgba(36,39,37,0.10)]"
            style={`background-color:${card.color};--card-rotate:${card.rotate}deg;${hoverStyle(index)}`}
          >
            <div>
              <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-ink/50">0{index + 1}</span>
              <h2 class="mt-5 display-heading text-3xl md:text-[2.15rem] text-[#241D35]">{card.title}</h2>
              <p class="mt-4 text-sm leading-relaxed text-ink/70">{card.text}</p>
            </div>
            <a href={card.href} class="w-fit rounded-xl bg-[#241D35] text-white px-4 py-3 text-xs font-bold shadow-md hover:translate-x-1 transition-transform">
              {card.action} <span aria-hidden="true">↗</span>
            </a>
          </article>
        </div>
      ) : (
        <div class="hero-in relative z-20 md:-ml-6 flex" style="--hero-y:50px;--hero-duration:.6s;--hero-delay:.27s">
          <div
            class="hero-card relative w-full min-h-[270px] md:min-h-[325px] overflow-hidden rounded-[1.75rem] border-[6px] border-white bg-[#2D2350] shadow-[0_24px_52px_rgba(36,39,37,0.15)]"
            style="--card-rotate:1.8deg;--hover-y:-38px;--hover-x:4px;--hover-rotate:-2.5deg;--hover-scale:1.075"
          >
            <img src="/photos/isaiah-hero.png" alt="Isaiah Adeleke" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>
            <span class="absolute bottom-5 left-5 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-bold text-[#2D2350] shadow-sm">Isaiah Adeleke</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Lift the hovered card's wrapper above its siblings, matching the old zIndex: 30 on hover. */
  .hero-in:has(> .hero-card:hover) { z-index: 30 !important; }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const layers = hero ? [...hero.querySelectorAll<HTMLElement>("[data-parallax]")] : [];
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && layers.length && !reducedMotion) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const { top, height } = hero.getBoundingClientRect();
      const progress = Math.min(Math.max(-top / height, 0), 1);
      for (const layer of layers) layer.style.transform = `translate3d(0, ${progress * Number(layer.dataset.parallax)}px, 0)`;
    };
    window.addEventListener("scroll", () => {
      if (!ticking) requestAnimationFrame(update);
      ticking = true;
    }, { passive: true });
    update();
  }
</script>
