---
import { profile } from "@/data/profile";
---

<div data-experience class="mt-12 grid items-start gap-6 md:grid-cols-[.95fr_1.25fr] md:gap-8">
  <div class="flex overflow-x-auto rounded-[1.5rem] border border-ink/10 bg-white/50 md:block" aria-label="Choose an experience">
    {profile.experience.map((item, index) => (
      <button
        type="button"
        data-job={index}
        aria-pressed={index === 0 ? "true" : "false"}
        aria-controls="experience-details"
        class="group flex w-64 shrink-0 items-center gap-4 border-r border-ink/10 px-6 py-5 text-left transition-colors last:border-r-0 md:w-full md:border-b md:border-r-0 md:last:border-b-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-[#7C56F6] text-[#2D2350] hover:bg-[#7C56F6]/5 aria-pressed:bg-[#7C56F6] aria-pressed:text-white aria-pressed:hover:bg-[#7C56F6]"
      >
        <span class="min-w-0 flex-1">
          <span class="block text-[10px] font-semibold uppercase tracking-[.1em] text-ink/50 group-aria-pressed:text-white/70">{item.period}</span>
          <span class="mt-2 block text-lg font-bold">{item.company}</span>
          <span class="mt-1 block text-xs text-ink/60 group-aria-pressed:text-white/80">{item.role}</span>
        </span>
        <span aria-hidden="true" class="text-xl text-[#7C56F6]/45 group-aria-pressed:text-white">→</span>
      </button>
    ))}
  </div>

  <div id="experience-details" class="page-card p-7 md:sticky md:top-28 md:p-9" aria-live="polite" aria-atomic="true">
    {profile.experience.map((job, index) => (
      <div data-job-detail={index} hidden={index !== 0}>
        <p class="text-[10px] font-bold uppercase tracking-[.13em] text-[#7C56F6]">{job.period}</p>
        <h3 class="display-heading mt-5 text-3xl text-[#2D2350] md:text-4xl">{job.company}</h3>
        <p class="mt-3 text-base font-semibold text-[#2D2350]">{job.role}</p>
        <p class="mt-2 text-xs text-muted">{job.location}</p>
        <ul class="mt-8 list-disc space-y-5 pl-5 text-sm leading-relaxed text-ink/75 marker:text-[#7C56F6]">
          {job.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </div>
    ))}
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-experience]")) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-job]")];
    const details = [...root.querySelectorAll<HTMLElement>("[data-job-detail]")];

    for (const button of buttons) {
      button.addEventListener("click", () => {
        for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
        for (const detail of details) detail.hidden = detail.dataset.jobDetail !== button.dataset.job;
      });
    }
  }
</script>
