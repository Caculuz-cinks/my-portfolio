---
const { slug, title } = Astro.props as { slug: string; title: string };
---

<div class="w-full aspect-[4/3] rounded-2xl bg-[#F0EDE8]/50 border border-ink/10 p-3 flex flex-col gap-2.5 shadow-sm transition-all duration-300 hover:shadow-md select-none group-hover:border-[#4930A8]/30">
  <div class="flex items-center justify-between px-1">
    <div class="flex gap-1.5 items-center">
      <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F56]"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E]"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F]"></span>
    </div>
    <div class="bg-white border border-ink/5 rounded-md px-4 py-0.5 text-[8px] text-muted text-center w-3/5 font-sans font-medium flex justify-center items-center gap-1">
      <span class="text-[#4930A8]/40">🔒</span>
      <span>{slug}.tride.co</span>
    </div>
    <div class="w-8"></div>
  </div>

{slug === "idiomscribe" ? (
<div class="flex-1 flex gap-3 p-3 overflow-hidden text-[10px] bg-white rounded-lg">
            <div class="w-2/5 border-r border-ink/5 pr-3 flex flex-col gap-3 justify-between">
              <div>
                <span class="inline-block bg-[#4930A8]/10 text-[#4930A8] font-semibold px-2 py-0.5 rounded text-[8px] uppercase tracking-wide">
                  Ambient Audio
                </span>
                <p class="mt-2 text-ink/40 italic leading-snug">
                  &quot;Patient presents with persistent cough for 3 days, no fever...&quot;
                </p>
              </div>
              <div class="flex items-center gap-1 h-6">
                {[4, 10, 14, 8, 12, 16, 6, 12, 18, 10, 4, 8, 12, 6].map((h) => (
                  <span class="flex-1 bg-[#4930A8] rounded-full"
                    style={`height:${h * 1.2}px`}></span>
                ))}
              </div>
            </div>
            <div class="flex-1 flex flex-col gap-2 overflow-y-auto">
              <div class="flex items-center justify-between border-b border-ink/5 pb-1">
                <span class="font-semibold text-[#4930A8]">SOAP Note Draft</span>
                <span class="bg-[#F0EDE8] px-1.5 py-0.5 rounded text-[8px] text-muted">Review Required</span>
              </div>
              <div class="flex flex-col gap-2">
                <div>
                  <span class="font-bold text-ink/75">Subjective:</span>
                  <p class="text-ink/65">3-day dry cough, mild congestion, chest tightness.</p>
                </div>
                <div>
                  <span class="font-bold text-ink/75">Objective:</span>
                  <p class="text-ink/65">Clear breath sounds. Throat slightly erythematous.</p>
                </div>
                <div class="bg-[#4930A8]/5 p-1.5 rounded border border-[#4930A8]/10">
                  <span class="font-bold text-[#4930A8]">AI Highlight:</span>
                  <p class="text-[#4930A8]/90 text-[8px] leading-tight">Click to verify transcript section [02:14].</p>
                </div>
              </div>
            </div>
          </div>
) : 
slug === "care-copilot" ? (
<div class="flex-1 flex gap-3 p-3 overflow-hidden text-[10px] bg-white rounded-lg">
            <div class="w-1/2 border-r border-ink/5 pr-3 flex flex-col gap-2">
              <div class="bg-[#F0EDE8]/50 p-2 rounded">
                <span class="text-muted block text-[8px]">PATIENT RECORD</span>
                <span class="font-bold block mt-0.5">Amara K. (Age 28)</span>
                <span class="text-ink/60">Vitals: BP 110/70, Temp 38.5°C</span>
              </div>
              <div>
                <span class="text-muted block text-[8px]">CLINICAL NOTES</span>
                <p class="text-ink/60 leading-snug mt-1">
                  Complaining of acute abdominal pain in right lower quadrant, nausea, onset 12 hours ago.
                </p>
              </div>
            </div>
            <div class="flex-1 flex flex-col gap-2">
              <span class="text-muted block text-[8px] font-bold tracking-wide">AI CLINICAL SUGGESTIONS</span>
              <div class="bg-amber-50 border border-amber-200 p-2 rounded flex flex-col gap-1">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-amber-800">1. Acute Appendicitis</span>
                  <span class="bg-amber-100 text-amber-800 px-1 py-0.2 rounded text-[7px]">High Risk</span>
                </div>
                <p class="text-amber-700 text-[8px] leading-snug">
                  Vitals and focal pain are highly indicative. Recommend McBurney&apos;s point tenderness check.
                </p>
              </div>
              <div class="border border-[#4930A8]/20 bg-[#4930A8]/5 p-2 rounded flex flex-col gap-1">
                <span class="font-bold text-[#4930A8]">Suggested Questions</span>
                <p class="text-ink/75 text-[8px] leading-tight">
                  &quot;Does coughing or moving increase pain intensity?&quot;
                </p>
              </div>
            </div>
          </div>
) : 
slug === "ember" ? (
<div class="flex-1 flex flex-col justify-between p-3 bg-slate-900 rounded-lg text-[9px] text-white">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2">
              <div class="flex items-center gap-1.5">
                <div class="w-2 h-2 rounded-full bg-violet-500 animate-pulse"></div>
                <span class="font-semibold text-slate-300">Ember · Thinking Partner</span>
              </div>
              <span class="bg-slate-800 text-slate-400 px-2 py-0.5 rounded text-[8px]">Framework: Strategy</span>
            </div>
            <div class="flex-1 flex flex-col gap-2.5 justify-end py-3 overflow-hidden">
              <div class="bg-slate-800 p-2 rounded-lg max-w-[85%] self-end">
                <p class="text-slate-200">
                  I&apos;m stuck on whether to hire a marketing lead or another backend engineer first.
                </p>
              </div>
              <div class="bg-violet-950/60 border border-violet-900 p-2 rounded-lg max-w-[90%]">
                <span class="text-violet-400 font-bold block text-[7px] mb-0.5">EMBER PROMPT</span>
                <p class="text-violet-200 leading-snug">
                  What is the single biggest bottleneck in your business today? Is it capacity to build, or acquiring new users? Let&apos;s map the impact of both.
                </p>
              </div>
            </div>
            <div class="bg-slate-800 rounded px-2.5 py-1.5 flex justify-between items-center text-slate-500 text-[8px] border border-slate-700">
              <span>Classified as: Decision Dilemma...</span>
              <span class="text-violet-500">⌘+Enter</span>
            </div>
          </div>
) : 
slug === "tride" ? (
<div class="flex-1 flex flex-col gap-3 p-3 bg-white rounded-lg text-[10px]">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-[#4930A8]">Tride Account Creation</span>
              <span class="font-bold text-[#4930A8] bg-[#4930A8]/10 px-2 py-0.5 rounded">75% Done</span>
            </div>
            <div class="flex-1 flex flex-col gap-2 justify-center">
              <div class="flex items-center gap-2 text-violet-600">
                <span class="w-3.5 h-3.5 rounded-full bg-violet-50 border border-violet-300 flex items-center justify-center text-[8px] font-bold">✓</span>
                <span>Corporate Registration Verification (CAC)</span>
              </div>
              <div class="flex items-center gap-2 text-violet-600">
                <span class="w-3.5 h-3.5 rounded-full bg-violet-50 border border-violet-300 flex items-center justify-center text-[8px] font-bold">✓</span>
                <span>Director Identity Verification (BVN/NIN)</span>
              </div>
              <div class="flex items-center gap-2 text-[#4930A8] font-medium">
                <span class="w-3.5 h-3.5 rounded-full bg-[#4930A8]/10 border border-[#4930A8]/30 flex items-center justify-center text-[8px] font-bold animate-pulse">•</span>
                <span>Plain-Language Compliance Attestation</span>
              </div>
            </div>
            <div class="bg-[#F0EDE8]/50 p-2 rounded border border-ink/5 text-[8px] leading-normal text-muted flex items-center justify-between">
              <span>Time Elapsed: 16m 42s</span>
              <span class="font-bold text-ink">Estimated completion: 4m</span>
            </div>
          </div>
) : 
(
<div class="flex-1 bg-[#F0EDE8] border border-ink/5 rounded-lg flex items-center justify-center text-muted text-xs">
  {title} Showcase
</div>
)}
</div>
