---
import { shots } from "@/data/shots";
---

<div data-shots class="mx-auto mt-14 max-w-[1440px] px-5 md:px-10 lg:px-14">
  <div class="mb-7 flex flex-wrap items-center justify-between gap-4">
    <p class="text-sm text-muted">Scroll to explore. Hover or focus a design to pause.</p>
    <button type="button" data-pause aria-pressed="false" class="rounded-full border border-[#7C56F6]/25 bg-white px-5 py-2.5 text-xs font-bold text-[#4930A8] motion-reduce:hidden">Pause motion Ⅱ</button>
  </div>
  <div data-hover-zone>
    <div data-pane tabindex="0" aria-label="UI shots gallery. Scroll to browse designs." class="no-scrollbar h-[160dvh] min-h-[1000px] overflow-y-auto overscroll-contain focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7C56F6] md:h-[180dvh] md:min-h-[1500px]">
      {[false, true].map((duplicate) => (
        <div aria-hidden={duplicate ? "true" : undefined} class="columns-2 gap-5 px-1 pb-1 md:columns-3 md:gap-7 xl:columns-4">
          {shots.map((shot) => (
            <figure class="mb-8 break-inside-avoid md:mb-10">
              <button type="button" data-shot-src={shot.src} data-shot-alt={shot.alt} data-shot-label={shot.label} tabindex={duplicate ? -1 : undefined} aria-label={`View ${shot.label}`} class="group/shot relative block w-full overflow-hidden rounded-2xl border border-ink/10 bg-white focus-visible:z-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#7C56F6]">
                <img src={shot.src} alt={duplicate ? "" : shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" class="block h-auto w-full transition-transform duration-300 group-hover/shot:scale-[1.015] motion-reduce:transition-none" />
                <span class="absolute inset-0 flex items-center justify-center bg-[#241D35]/25 opacity-0 transition-opacity group-hover/shot:opacity-100 group-focus-visible/shot:opacity-100"><span class="rounded-full bg-white px-4 py-2 text-xs font-bold text-[#4930A8]">View shot ↗</span></span>
              </button>
              <figcaption class="mt-3 text-[11px] font-medium leading-snug text-[#2D2350] md:text-sm">{shot.label}</figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
  </div>
  <dialog aria-label="UI shot" class="fixed inset-0 m-auto h-[94dvh] max-h-none w-[96vw] max-w-none flex-col overflow-hidden rounded-2xl border-0 bg-[#FCFAF6] p-4 shadow-2xl backdrop:bg-[#241D35]/80 open:flex md:p-6">
    <div class="mb-4 flex shrink-0 items-center justify-between gap-4">
      <p data-dialog-label class="text-sm font-semibold text-[#2D2350] md:text-base"></p>
      <button type="button" data-close autofocus class="shrink-0 rounded-full bg-[#4930A8] px-4 py-2 text-xs font-bold text-white">Close ×</button>
    </div>
    <img data-dialog-image alt="" class="min-h-0 w-full flex-1 object-contain" />
  </dialog>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-shots]")) {
    const pane = root.querySelector<HTMLElement>("[data-pane]")!;
    const zone = root.querySelector<HTMLElement>("[data-hover-zone]")!;
    const pauseButton = root.querySelector<HTMLButtonElement>("[data-pause]")!;
    const dialog = root.querySelector("dialog")!;
    const dialogImage = root.querySelector<HTMLImageElement>("[data-dialog-image]")!;
    const dialogLabel = root.querySelector<HTMLElement>("[data-dialog-label]")!;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let paused = false;
    let hovering = false;
    let focused = false;
    let visible = false;
    let position = pane.scrollTop;
    let previous = 0;

    const running = () => !paused && !hovering && !focused && !reducedMotion.matches && !dialog.open;

    const animate = (time: number) => {
      const elapsed = previous ? Math.min(time - previous, 64) / 1000 : 0;
      previous = time;
      if (running() && visible && !document.hidden) {
        const loopHeight = pane.firstElementChild?.getBoundingClientRect().height ?? 0;
        position += elapsed * 28;
        if (loopHeight && position >= loopHeight) position -= loopHeight;
        pane.scrollTop = position;
      } else {
        // Pick up wherever the visitor scrolled to while motion was paused.
        position = pane.scrollTop;
      }
      requestAnimationFrame(animate);
    };

    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(root);
    requestAnimationFrame(animate);

    const setPaused = (value: boolean) => {
      paused = value;
      pauseButton.setAttribute("aria-pressed", String(paused));
      pauseButton.textContent = paused ? "Resume motion ▶" : "Pause motion Ⅱ";
    };

    pauseButton.addEventListener("click", () => setPaused(!paused));
    zone.addEventListener("touchstart", () => setPaused(true), { passive: true });
    zone.addEventListener("mouseenter", () => (hovering = true));
    zone.addEventListener("mouseleave", () => (hovering = false));
    zone.addEventListener("focusin", () => (focused = true));
    zone.addEventListener("focusout", (event) => {
      if (!zone.contains(event.relatedTarget as Node | null)) focused = false;
    });

    pane.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-shot-src]");
      if (!button) return;
      dialogImage.src = button.dataset.shotSrc!;
      dialogImage.alt = button.dataset.shotAlt!;
      dialogLabel.textContent = button.dataset.shotLabel!;
      dialog.setAttribute("aria-label", button.dataset.shotLabel!);
      dialog.showModal();
    });
    root.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
