---
import RichText from "./RichText.astro";
import ProjectVisual from "./ProjectVisual.astro";
import type { ArticleBlock } from "@/data/articles";

const { block } = Astro.props as { block: ArticleBlock };
const checkoutRows = [
  { label: "Before redesign", financing: 47, cash: 53 },
  { label: "After redesign", financing: 89, cash: 11 },
];
---

{block.type === "text" ? (
  <p class="text-base leading-[1.85] text-ink/80 md:text-lg"><RichText text={block.text} /></p>
) : block.type === "subheading" ? (
  <h3 class="pt-4 text-xl font-bold leading-snug text-[#2D2350] md:text-2xl">{block.text}</h3>
) : block.type === "quote" ? (
  <blockquote class="rounded-r-2xl border-l-2 border-[#7C56F6] bg-[#7C56F6]/5 px-6 py-5 text-lg font-semibold leading-relaxed text-[#4930A8]">{block.text}</blockquote>
) : block.type === "bullets" ? (
  <ul class="space-y-4 pl-6 text-base leading-[1.85] text-ink/80 marker:text-[#7C56F6] md:text-lg list-disc">{block.items.map((item) => <li><RichText text={item} /></li>)}</ul>
) : block.type === "steps" ? (
  <ol class="space-y-4 pl-6 text-base leading-[1.85] text-ink/80 marker:text-[#7C56F6] md:text-lg list-decimal marker:font-bold">{block.items.map((item) => <li><RichText text={item} /></li>)}</ol>
) : block.type === "image" ? (
  <figure class="py-3"><div class="overflow-hidden rounded-[1.4rem] border border-ink/10 bg-white"><img src={block.src} alt={block.alt} loading="lazy" decoding="async" class="h-auto w-full" /></div>{block.caption && <figcaption class="mt-3 text-xs font-medium leading-relaxed text-muted">{block.caption}</figcaption>}</figure>
) : block.type === "imageSpace" ? (
  <ProjectVisual visual={{ type: "showcase", title: block.title, slots: block.slots, caption: block.caption }} />
) : block.type === "cards" ? (
  <div class:list={["grid gap-4 py-3", block.columns.length === 3 ? "lg:grid-cols-3" : "sm:grid-cols-2"]}>{block.columns.map((column) => <div class="rounded-2xl border border-[#7C56F6]/15 bg-[#F4F0FF] p-6"><p class="text-[10px] font-bold uppercase tracking-[.13em] text-[#7C56F6]">{column.label}</p><h3 class="mt-5 text-lg font-bold leading-snug text-[#2D2350]">{column.title}</h3><p class="mt-3 text-sm leading-relaxed text-ink/65">{column.text}</p></div>)}</div>
) : block.type === "metrics" ? (
  <div class="grid gap-4 sm:grid-cols-3">{block.items.map((item) => <div class="rounded-2xl border border-[#7C56F6]/15 bg-[#F4F0FF] p-6"><p class="display-heading text-3xl text-[#7C56F6]">{item.value}</p><p class="mt-3 text-xs font-semibold leading-relaxed text-[#2D2350]">{item.label}</p></div>)}</div>
) : block.type === "journey" ? (
  <figure class="rounded-[1.5rem] border border-[#7C56F6]/15 bg-[#F5F1FE] p-5 md:p-7"><figcaption class="mb-6 text-xs font-bold uppercase tracking-[.12em] text-[#4930A8]">{block.title}</figcaption><div class:list={["grid gap-5", block.columns.length > 1 && "sm:grid-cols-2"]}>{block.columns.map((column) => <div><p class="mb-4 text-sm font-semibold text-[#4930A8]">{column.label}</p><ol>{column.steps.map((step, index) => <li><div class:list={["flex items-center gap-3 rounded-xl border px-4 py-3 text-sm", step.toLowerCase().includes("financing") ? "border-[#7C56F6]/30 bg-[#7C56F6]/10 font-bold text-[#4930A8]" : "border-white bg-white/90 text-ink/70"]}><span class="text-xs text-[#7C56F6]">0{index + 1}</span>{step}</div>{index < column.steps.length - 1 && <div aria-hidden="true" class="py-1 text-center text-[#7C56F6]/70">↓</div>}</li>)}</ol>{column.note && <p class="mt-4 rounded-xl border border-dashed border-[#7C56F6]/25 px-4 py-3 text-xs leading-relaxed text-[#4930A8]">{column.note}</p>}</div>)}</div></figure>
) : block.type === "checkoutChart" ? (
  <figure class="rounded-[1.5rem] border border-[#7C56F6]/15 bg-[#F5F1FE] p-5 md:p-7"><figcaption class="text-sm font-bold text-[#2D2350]">Financing checkout share before and after the redesign</figcaption><div class="mt-7 space-y-6">{checkoutRows.map((row) => <div><p class="mb-2 text-xs font-semibold text-ink/70">{row.label}</p><div class="flex h-12 overflow-hidden rounded-xl text-xs font-bold sm:text-sm" role="img" aria-label={`${row.label}: ${row.financing}% financing, ${row.cash}% cash`}><div class="flex items-center justify-center bg-[#7C56F6] text-white" style={`width:${row.financing}%`}>{row.financing}%</div><div class="flex items-center justify-center bg-[#DDD6EB] text-[#514866]" style={`width:${row.cash}%`}>{row.cash}%</div></div></div>)}</div><div class="mt-5 flex flex-wrap gap-5 text-xs text-ink/65"><span class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-[#7C56F6]"></i>Financing</span><span class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-[#DDD6EB]"></i>Cash</span></div><p class="mt-6 border-t border-[#7C56F6]/15 pt-5 text-sm text-[#4930A8]"><strong>+42 percentage points</strong> in financing&apos;s share of checkouts after the redesign.</p></figure>
) : null}
